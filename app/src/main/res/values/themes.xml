<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Panager" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand colour: buttons, headers, main call-to-action elements -->
        <item name="colorPrimary">@color/primary_red</item>
        <item name="colorPrimaryDark">@color/primary_red</item>
        <item name="colorOnPrimary">@color/off_white</item>

        <!-- Secondary colour: edit actions, warnings, secondary buttons -->
        <item name="colorSecondary">@color/secondary_coral</item>
        <item name="colorOnSecondary">@color/text_on_accent</item>

        <!-- Background and surface colours -->
        <item name="android:windowBackground">@color/background_page</item>
        <item name="android:colorBackground">@color/background_page</item>
        <item name="colorSurface">@color/card_background</item>

        <!-- Status bar matches the brand colour -->
        <item name="android:statusBarColor" tools:targetApi="21">@color/primary_red</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>
</resources>
